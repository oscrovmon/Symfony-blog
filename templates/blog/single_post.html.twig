{% extends 'base.html.twig' %}
{% block title %}{{ post.title }}{% endblock %}
{% block body %}
<!-- Principal Content Start -->
   <div id="single">
     <div class="container">

    <!-- Full Article -->
      <div class="row">
      <h2>{{ post.title }}</h2>
      <hr class="subtitle">
      <div class=" block1">
      <div class="col-xs-12 col-sm-9">
        {% if post.image %}
        <img class="img-responsive" src="{{ asset('images/blog/' ~ post.image) }}" alt="{{ post.title }}" style="margin-bottom: 20px;">
        {% endif %}

        <p>{{ post.content }}</p>

        <h4>- By {{ post.postUser ? post.postUser.email : 'Anonymous' }}</h4>
        <hr>
        <ul class="list-inline">
          <li>{{ post.publishedAt | date('d F Y') }} |</li>
          <li><a class="page-scroll" href="#form"><i class="fa fa-comments sr-icons"></i> COMMENT ({{ post.numComments ?? post.comments|length }})</a> |</li>
          <li><a href="{{ path('post_like', {'slug': post.slug}) }}"><i class="fa fa-heart sr-icons"></i> LIKE ({{ post.numLikes|default(0) }})</a></li>
        </ul>
      </div>
      <div class="col-xs-12 col-sm-3">
        <h4>Recent Post</h4>
        <hr class="subtitle1">
        {% for recent in recents %}
        {{ include ('partials/_recent_post.html.twig', {'recent': recent}) }}
        {% endfor %}
      </div>
      </div>
      </div>
    <!-- End of Full Article -->

    <!-- Comments -->
     {% for comment in post.comments %}
      {% include 'partials/_recent_comments.html.twig' %}
     {% endfor %}
      {{ include ('partials/_post_comments.html.twig') }}
    <!-- End of Comments -->
      </div>
   </div>
<!-- End of Principal Content -->
{% endblock %}
